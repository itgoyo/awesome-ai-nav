    }</script><script>// Server time synchronization
    (function () {
      var serverTime = 1783481538 * 1000;
      var clientTime = Date.now();
      window.__serverTimeOffset = serverTime - clientTime;
    })();</script><script>window.__startTime = Date.now();</script><script>// 异步加载 aegis 上报脚本，避免加载慢时阻塞页面渲染
    if ('production' !== 'local') {
      // eslint-disable-next-line no-var
      var aegisScript = document.createElement('script');
      aegisScript.src = 'https://cdn-go.cn/aegis/aegis-sdk/latest/aegis.min.js';
      aegisScript.async = true;
      aegisScript.onload = function () {
        window.aegis = new Aegis({
          id: 'xaOZIvClFaTlTUzXSd', // 项目ID，即上报id
          uin: '', // 用户唯一 ID（可选）
          reportApiSpeed: true, // 接口测速
          reportAssetSpeed: true, // 静态资源测速
          spa: true, // spa 页面开启
          env: 'production',
          hostUrl: 'https://rumt-zh.com',
          version: '0.0.2', // 手动设置的版本，用来判断是否存在缓存
          api: {
            apiDetail: true,
            retCodeHandler(data, url, xhr) {
              // 注意这里的 data 的数据类型，跟接口返回值的数据类型一致，开发者需要根据实际情况自行处理
              // fetch 请求的时候，data 是 string，如果需要对象需要手动 parse 下
              // xhr 请求的时候，data 是 xhr.response 拿到完整的后台响应
              let data2;
              try {
                data2 = JSON.parse(data);
              } catch (e) { }
              let isErr = !/20./.test(String(xhr.status));
              let code = xhr.status;
              // 返回体异常
              if (data === '' && data2 === undefined) {
                return { isErr: true, code };
              }
              if (url.includes('config.v2.ConfigService/PullConfigReq') && xhr.status === 0) {
                isErr = false;
                code = 200;
              }
              return {
                isErr,
                code,
              };
            },
          },
        });
      };
      document.head.appendChild(aegisScript);
    }</script><link rel="stylesheet" href="https://staticfile.qq.com/creative-market/p414eb1bd203c483983472b4ff97af5a7/a9c1d20853794b3a8f6dfed6cae48c4d/style/css-layer-order.345c0986.css"/><link rel="stylesheet" href="https://staticfile.qq.com/creative-market/p414eb1bd203c483983472b4ff97af5a7/c325835bee254909a2cb8bbd968cd7bc/spaui-shim.56720c2d.css"/><link rel="stylesheet" href="https://staticfile.qq.com/creative-market/p414eb1bd203c483983472b4ff97af5a7/c325835bee254909a2cb8bbd968cd7bc/od-icon-shim.31bb3040.css"/><link rel="stylesheet" href="https://staticfile.qq.com/creative-market/p414eb1bd203c483983472b4ff97af5a7/c325835bee254909a2cb8bbd968cd7bc/odc-shim.5d4bcdc3.css"/><link rel="stylesheet" href="https://staticfile.qq.com/creative-market/p414eb1bd203c483983472b4ff97af5a7/c325835bee254909a2cb8bbd968cd7bc/creative-aiTool-shim.4f221e94.css"/><link rel="stylesheet" href="//ad.qq.com/ai/doc/ai-customer/assets/sdk.css"/><script type="module" crossorigin src="https://staticfile.qq.com/ams-aigc/muse_platform/latest/assets/index-BO8jDsVm.js"></script><link rel="modulepreload" crossorigin href="https://staticfile.qq.com/ams-aigc/muse_platform/latest/assets/moment-DPrpf9vT.js"><link rel="modulepreload" crossorigin href="https://staticfile.qq.com/ams-aigc/muse_platform/latest/assets/third-part-libs-CGDuPUqH.js"><link rel="modulepreload" crossorigin href="https://staticfile.qq.com/ams-aigc/muse_platform/latest/assets/recoil-DWodj3jI.js"><link rel="modulepreload" crossorigin href="https://staticfile.qq.com/ams-aigc/muse_platform/latest/assets/index-CZUF-Lv2.js"><link rel="stylesheet" crossorigin href="https://staticfile.qq.com/ams-aigc/muse_platform/latest/assets/third-part-libs-CCalOiej.css"><link rel="stylesheet" crossorigin href="https://staticfile.qq.com/ams-aigc/muse_platform/latest/assets/tacc-BEHBV2VJ.css"><link rel="stylesheet" crossorigin href="https://staticfile.qq.com/ams-aigc/muse_platform/latest/assets/ms-ui-T0nIFytT.css"><link rel="stylesheet" crossorigin href="