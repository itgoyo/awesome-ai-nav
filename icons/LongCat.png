        var userAgent = navigator.userAgent;
        var isMobileDevice = /iPhone|iPad|iPod|Android|Mobile|BlackBerry|webOS|Windows Phone/i.test(userAgent);
        function updateHtmlClasses() {
          var htmlElement = document.documentElement;
          htmlElement.classList.remove('mobile', 'is-ios', 'is-iphone', 'is-android');
          if (isMobileDevice) {
            htmlElement.classList.add('mobile');
          }
          if (/iPhone/.test(userAgent)) {
            htmlElement.classList.add('is-ios', 'is-iphone');
          } else if (/iPad|iPod/.test(userAgent)) {
            htmlElement.classList.add('is-ios');
          } else if (/Android/.test(userAgent)) {
            htmlElement.classList.add('is-android');
          }
        }
        updateHtmlClasses();
        var resizeTimer;
        window.addEventListener('resize', function () {
          clearTimeout(resizeTimer);
          resizeTimer = setTimeout(updateHtmlClasses, 100);
        });
        window.updateHtmlClasses = updateHtmlClasses;
