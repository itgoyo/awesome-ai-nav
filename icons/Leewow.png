		<script async type="text/javascript" src="https://accounts.google.com/gsi/client"></script>
		<style>
			#app-loading {
				position: fixed;
				top: 0;
				left: 0;
				width: 100%;
				height: 100%;
				background: #fff;
				display: flex;
				align-items: center;
				justify-content: center;
				z-index: 9999;
			}
			/* ldrs Grid 效果，与 FullscreenLoading 一致 */
			.app-loading-grid {
				--uib-size: 60px;
				--uib-color: black;
				--uib-speed: 1.5s;
				flex-shrink: 0;
				display: inline-flex;
				align-items: center;
				justify-content: center;
				height: calc(var(--uib-size) * 0.8);
				width: var(--uib-size);
			}
			.app-loading-grid-inner {
				--uib-dot-size: calc(var(--uib-size) * 0.1);
				position: relative;
				display: flex;
				align-items: center;
				justify-content: flex-start;
				height: calc(var(--uib-size) * 0.64);
				width: calc(var(--uib-size) * 0.64);
			}
			.app-loading-grid-dot {
				--uib-scale: 1;
				position: absolute;
				bottom: calc(var(--uib-bottom) + var(--uib-dot-size) / 2);
				right: calc(var(--uib-right) + var(--uib-dot-size) / 2);
				display: flex;
				align-items: center;
				justify-content: flex-start;
				height: var(--uib-dot-size);
				width: var(--uib-dot-size);
				animation: app-loading-grid-jump var(--uib-speed) ease-in-out infinite;
				opacity: var(--uib-scale);
				will-change: transform;
				backface-visibility: hidden;
			}
			.app-loading-grid-dot::before {
				content: "";
				height: 100%;
				width: 100%;
				background-color: var(--uib-color);
				border-radius: 50%;
				transform: scale(var(--uib-scale));
			}
			.app-loading-grid-dot:nth-child(1) { --uib-bottom: 24%; --uib-right: -35%; animation-delay: calc(var(--uib-speed) * -0.48); }
			.app-loading-grid-dot:nth-child(2) { --uib-bottom: 16%; --uib-right: -6%; animation-delay: calc(var(--uib-speed) * -0.4); }
			.app-loading-grid-dot:nth-child(3) { --uib-bottom: 8%; --uib-right: 23%; animation-delay: calc(var(--uib-speed) * -0.32); --uib-scale: 0.98; }
			.app-loading-grid-dot:nth-child(4) { --uib-bottom: -1%; --uib-right: 51%; animation-delay: calc(var(--uib-speed) * -0.24); }
			.app-loading-grid-dot:nth-child(5) { --uib-bottom: 38%; --uib-right: -17.5%; animation-delay: calc(var(--uib-speed) * -0.4); --uib-scale: 0.9; }
			.app-loading-grid-dot:nth-child(6) { --uib-bottom: 30%; --uib-right: 10%; animation-delay: calc(var(--uib-speed) * -0.32); --uib-scale: 0.92; }
			.app-loading-grid-dot:nth-child(7) { --uib-bottom: 22%; --uib-right: 39%; animation-delay: calc(var(--uib-speed) * -0.24); --uib-scale: 0.94; }
			.app-loading-grid-dot:nth-child(8) { --uib-bottom: 14%; --uib-right: 67%; animation-delay: calc(var(--uib-speed) * -0.16); --uib-scale: 0.96; }
			.app-loading-grid-dot:nth-child(9) { --uib-bottom: 53%; --uib-right: -0.8%; animation-delay: calc(var(--uib-speed) * -0.32); --uib-scale: 0.86; }
			.app-loading-grid-dot:nth-child(10) { --uib-bottom: 44.5%; --uib-right: 27%; animation-delay: calc(var(--uib-speed) * -0.24); --uib-scale: 0.88; }
			.app-loading-grid-dot:nth-child(11) { --uib-bottom: 36%; --uib-right: 55.7%; animation-delay: calc(var(--uib-speed) * -0.16); --uib-scale: 0.9; }
			.app-loading-grid-dot:nth-child(12) { --uib-bottom: 28.7%; --uib-right: 84.3%; animation-delay: calc(var(--uib-speed) * -0.08); --uib-scale: 0.92; }
			.app-loading-grid-dot:nth-child(13) { --uib-bottom: 66.8%; --uib-right: 15%; animation-delay: calc(var(--uib-speed) * -0.24); --uib-scale: 0.82; }
			.app-loading-grid-dot:nth-child(14) { --uib-bottom: 58.8%; --uib-right: 43%; animation-delay: calc(var(--uib-speed) * -0.16); --uib-scale: 0.84; }
			.app-loading-grid-dot:nth-child(15) { --uib-bottom: 50%; --uib-right: 72%; animation-delay: calc(var(--uib-speed) * -0.08); --uib-scale: 0.86; }
			.app-loading-grid-dot:nth-child(16) { --uib-bottom: 42%; --uib-right: 100%; animation-delay: 0s; --uib-scale: 0.88; }
			@keyframes app-loading-grid-jump {
				0%, 100% { transform: translateY(120%); }
				50% { transform: translateY(-120%); }
			}
		</style>
		
