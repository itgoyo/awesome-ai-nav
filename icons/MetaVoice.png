<!DOCTYPE html><!-- Last Published: Fri May 15 2026 15:41:56 GMT+0000 (Coordinated Universal Time) --><html data-wf-domain="www.metavoice.io" data-wf-page="67e89c2678967b8182fdf06b" data-wf-site="67a2e4aff035250ae11d8479" lang="en"><head><meta charset="utf-8"/><link href="https://cdn.prod.website-files.com" rel="preconnect" crossorigin="anonymous"/><title>MetaVoice | Voice AI that feels like your best human agent</title><meta content="Build voice agents that perform like your best human reps and feel natural to talk to. Real-time AI for sales and lead qualification." name="description"/><meta content="MetaVoice | Voice AI that feels like your best human agent" property="og:title"/><meta content="Build voice agents that perform like your best human reps and feel natural to talk to. Real-time AI for sales and lead qualification." property="og:description"/><meta content="https://cdn.themetavoice.xyz/website/metavoice.png" property="og:image"/><meta content="MetaVoice | Voice AI that feels like your best human agent" name="twitter:title"/><meta content="Build voice agents that perform like your best human reps and feel natural to talk to. Real-time AI for sales and lead qualification." name="twitter:description"/><meta content="https://cdn.themetavoice.xyz/website/metavoice.png" name="twitter:image"/><meta property="og:type" content="website"/><meta content="summary_large_image" name="twitter:card"/><meta content="width=device-width, initial-scale=1" name="viewport"/><link href="https://cdn.prod.website-files.com/67a2e4aff035250ae11d8479/css/metavoice.webflow.shared.789acf922.min.css" rel="stylesheet" type="text/css" integrity="sha384-eJrPki5sFJwKuIZBR7rCvfn2wsIPGnAV2a0hhCQM7pvt0+2qDsa9zgQ7RZyVa5W0" crossorigin="anonymous"/><script type="text/javascript">!function(o,c){var n=c.documentElement,t=" w-mod-";n.className+=t+"js",("ontouchstart"in o||o.DocumentTouch&&c instanceof DocumentTouch)&&(n.className+=t+"touch")}(window,document);</script><link href="https://cdn.prod.website-files.com/67a2e4aff035250ae11d8479/67d3b9490cae6790080b8141_favicon-32x32.png" rel="shortcut icon" type="image/x-icon"/><link href="https://cdn.prod.website-files.com/67a2e4aff035250ae11d8479/67d3b988adc963ddef935707_favicon%20(1).ico" rel="apple-touch-icon"/><style>
  :root {
    --primary-color: #2d2d2d;
    --text-color: #ffffff;
    --bg-color: #121212;
    --primary-purple: #6C5CE7; /* Bright purple matching the image */
    --hover-purple: #5245B5;  /* Darker purple for hover state */
  }

  .audio-btn1 {
    background-color: #fafafa;
    color: #000;
    border: none;
    border-radius: 4px;
    padding: 8px 16px;
    font-size: 14px;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 8px;
    transition: background-color 0.2s ease;
    box-shadow: 0px 2px 4px rgba(0, 0, 0, 0.08); /* Soft shadow */
  }

  .audio-btn1:hover {
    background-color: #e6e6e6;
    transform: scale(1.01); /* Slight pop effect */
  }

  .audio-btn {
    background-color: var(--primary-color);
    color: var(--text-color);
    border: none;
    border-radius: 4px;
    padding: 8px 16px;
    font-size: 14px;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 8px;
    transition: background-color 0.2s ease;
  }

  .audio-btn:hover {
    background-color: #3d3d3d;
    transform: scale(1.01); /* Slight pop effect */
  }

  /* SVG Icons */
  svg {
    width: 18px;
    height: 18px;
    fill: currentColor;
  }

  .hidden {
    display: none;
  }

  .access-btn {
    background-color: var(--primary-purple);
    color: var(--text-color);
    border: none;
    border-radius: 28px; /* Very rounded corners */
    padding: 12px 24px;
    font-size: 18px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    font-weight: 500;
    cursor: pointer;
    transition: background-color 0.2s ease-in-out, transform 0.1s ease-in-out;
    text-align: center;
    box-shadow: 0px 2px 4px rgba(0, 0, 0, 0.1);
    position: relative;

    /* Centered alignment styling */
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px; /* Space between icon and text */
    width: fit-content;
    margin: 0 auto; /* Center the button itself */
    
    min-width: 194px;
  }

  .access-btn:hover {
    background-color: var(--hover-purple);
    transform: scale(1.02);
  }

  @media screen and (max-width: 767px) {
    .access-btn {
      font-size: 16px;
    }

    .access-btn svg {
      width: 18px; /* Optional: slightly reduce icon size to match smaller text */
      height: 18px;
    }
  }

  .access-btn:active {
    transform: scale(0.98);
  }

  /* Enhanced shiny animated border */
  .access-btn::before {
    content: '';
    position: absolute;
    top: -4px;
    left: -4px;
    right: -4px;
    bottom: -4px;
    border-radius: 32px;
    background: linear-gradient(90deg, 
      transparent 0%,
      rgba(255, 255, 255, 0.2) 20%,
      rgba(255, 255, 255, 0.8) 45%,
      #ffffff 50%,
      rgba(255, 255, 255, 0.8) 55%,
      rgba(255, 255, 255, 0.2) 80%,
      transparent 100%
    );
    background-size: 200% 100%;
    animation: shine 3s linear infinite;
    z-index: -1;
    box-shadow: 0 0 15px rgba(255, 255, 255, 0.5);
  }

  /* Inner button background */
  .access-btn::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: var(--primary-purple);
    border-radius: 28px;
    z-index: -1;
    transition: background-color 0.2s ease-in-out;
  }

  @keyframes shine {
    0% {
      background-position: 200% 0;
    }
    100% {
      background-position: -200% 0;
    }
  }

  .access-btn:hover::after {
    background-color: var(--hover-purple);
  }
</style><script type="text/javascript">window.__WEBFLOW_CURRENCY_SETTINGS = {"currencyCode":"USD","symbol":"$","decimal":".","fractionDigits":2,"group":",","template":"{{wf {\"path\":\"symbol\",\"type\":\"PlainText\"} }} {{wf {\"path\":\"amount\",\"type\":\"CommercePrice\"} }} {{wf {\"path\":\"currencyCode\",\"type\":\"PlainText\"} }}","hideDecimalForWholeNumbers":false};</script></head><body class="body-11"><div class="navbar manifest"><div data-animation="default" data-collapse="medium" data-duration="400" data-easing="ease" data-easing2="ease" role="banner" class="navbar-container w-nav"><div data-w-id="da360a12-d98b-28a8-62c2-b5a2b637536b" class="navbar-container-wrap"><div class="navbar-wrapper"><a href="/" aria-current="page" class="navbar-brand w-nav-brand w--current"><img width="150" height="Auto" alt="" src="https://cdn.prod.website-files.com/67a2e4aff035250ae11d8479/67d3b616d08eea26bafa394b_metavoice_color.png" loading="lazy" srcset="https://cdn.prod.website-files.com/67a2e4aff035250ae11d8479/67d3b616d08eea26bafa394b_metavoice_color-p-500.png 500w, https://cdn.prod.website-files.com/67a2e4aff035250ae11d8479/67d3b616d08eea26bafa394b_metavoice_color-p-800.png 800w, https://cdn.prod.website-files.com/67a2e4aff035250ae11d8479/67d3b616d08eea26bafa394b_metavoice_color.png 1000w" sizes="150px" class="navbar-brand-logo manifest"/></a><div class="div-block"><nav role="navigation" class="nav-menu-wrapper w-nav-menu"><a href="https://careers.metavoice.io/" target="_blank" class="nav-link mobile w-nav-link">JOIN US</a><a href="/blog" class="nav-link mobile w-nav-link">BLOG</a><a href="https://tts.metavoice.io" target="_blank" class="nav-link mobile speech1 w-nav-link">TRY SPEECH-1 NOW</a></nav><div class="nav-right-wrap"><div class="nav-right"></div><div class="menu-button w-nav-button"><div class="w-icon-nav-menu"></div></div></div></div></div></div></div></div><section class="hero-03 manifest"><div class="container manifest"><div class="code-embed w-embed"><div class="top-banner">
  <a href="blog/bitter-lesson-ai-voice-conversations" class="banner-link">
    ✨ New blog: Taking the Bitter Lesson to Heart for Speech-to-Speech Models ✨
  </a>
</div>

<style>
.top-banner {
  width: 70%;
