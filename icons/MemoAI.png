class="VPNavBarHamburger hamburger" aria-label="mobile navigation" aria-expanded="false" aria-controls="VPNavScreen" data-v-ce3260fb data-v-af6e6dda><span class="container" data-v-af6e6dda><span class="top" data-v-af6e6dda></span><span class="middle" data-v-af6e6dda></span><span class="bottom" data-v-af6e6dda></span></span></button></div></div></div></div><div class="divider" data-v-ce3260fb><div class="divider-line" data-v-ce3260fb></div></div></div><!----></header><!----><!----><div class="VPContent is-home" id="VPContent" data-v-c15a287c data-v-d88da310><div class="VPHome" data-v-d88da310 data-v-ee3f2057><!--[--><!--]--><div class="VPHero has-image VPHomeHero" data-v-ee3f2057 data-v-9c7f82be><div class="container" data-v-9c7f82be><div class="main" data-v-9c7f82be><!--[--><!--]--><!--[--><h1 class="heading" data-v-9c7f82be><span class="name clip" data-v-9c7f82be>MemoAI</span><span class="text" data-v-9c7f82be>Video to translated text, subtitles and notes made easy.</span></h1><p class="tagline" data-v-9c7f82be>Whether it's YouTube, Podcast or local audio and video files, convert text and concentrate the essence.</p><!--]--><!--[--><!--]--><div class="actions" data-v-9c7f82be><!--[--><div class="action" data-v-9c7f82be><a class="VPButton medium brand" href="/download" data-v-9c7f82be data-v-da0e2442>Try for free（Windows/macOS）</a></div><div class="action" data-v-9c7f82be><a class="VPButton medium alt" href="/guide/start-here" data-v-9c7f82be data-v-da0e2442>Learn more</a></div><!--]--></div><!--[--><!--]--></div><div class="image" data-v-9c7f82be><div class="image-container" data-v-9c7f82be><div class="image-bg" data-v-9c7f82be></div><!--[--><!--[--><img class="VPImage image-src" src="https://vip2.loli.io/2023/08/12/U46e1nEJz2XIxLl.png" alt data-v-ce3e4708><!--]--><!--]--></div></div></div></div><!--[--><!--]--><!--[--><!--]--><div class="VPFeatures VPHomeFeatures" data-v-ee3f2057 data-v-b2dd8c3f><div class="container" data-v-b2dd8c3f><div class="items" data-v-b2dd8c3f><!--[--><div class="grid-4 item" data-v-b2dd8c3f><div class="VPLink no-icon VPFeature" data-v-b2dd8c3f data-v-0f8d4bce><!--[--><article class="box" data-v-0f8d4bce><div class="icon" data-v-0f8d4bce>🎥</div><h2 class="title" data-v-0f8d4bce>Video to Text</h2><p class="details" data-v-0f8d4bce>Easily convert YouTube videos, podcasts and more into text transcripts.</p><!----></article><!--]--></div></div><div class="grid-4 item" data-v-b2dd8c3f><div class="VPLink no-icon VPFeature" data-v-b2dd8c3f data-v-0f8d4bce><!--[--><article class="box" data-v-0f8d4bce><div class="icon" data-v-0f8d4bce>🌍</div><h2 class="title" data-v-0f8d4bce>Multi-language Support</h2><p class="details" data-v-0f8d4bce>Transcribe and translate between Chinese, English, Japanese and 90+ languages.</p><!----></article><!--]--></div></div><div class="grid-4 item" data-v-b2dd8c3f><div class="VPLink no-icon VPFeature" data-v-b2dd8c3f data-v-0f8d4bce><!--[--><article class="box" data-v-0f8d4bce><div class="icon" data-v-0f8d4bce>🌐</div><h2 class="title" data-v-0f8d4bce>Translation</h2><p class="details" data-v-0f8d4bce>Translate between 90+ languages while transcribing audio.</p><!----></article><!--]--></div></div><div class="grid-4 item" data-v-b2dd8c3f><div class="VPLink no-icon VPFeature" data-v-b2dd8c3f data-v-0f8d4bce><!--[--><article class="box" data-v-0f8d4bce><div class="icon" data-v-0f8d4bce>🎙️</div><h2 class="title" data-v-0f8d4bce>Speech synthesis</h2><p class="details" data-v-0f8d4bce>Support for voice-to-text, the text collectively called the new voice.</p><!----></article><!--]--></div></div><div class="grid-4 item" data-v-b2dd8c3f><div class="VPLink no-icon VPFeature" data-v-b2dd8c3f data-v-0f8d4bce><!--[--><article class="box" data-v-0f8d4bce><div class="icon" data-v-0f8d4bce>🧙‍♂️</div><h2 class="title" data-v-0f8d4bce>Speaker Diarization</h2><p class="details" data-v-0f8d4bce>Easier viewing of meetings, interview programs, podcast conversationalists and content, running locally for privacy.</p><!----></article><!--]--></div></div><div class="grid-4 item" data-v-b2dd8c3f><div class="VPLink no-icon VPFeature" data-v-b2dd8c3f data-v-0f8d4bce><!--[--><article class="box" data-v-0f8d4bce><div class="icon" data-v-0f8d4bce>💻</div><h2 class="title" data-v-0f8d4bce>NVIDIA and AMD GPU Acceleration</h2><p class="details" data-v-0f8d4bce>A GTX-4090 can process a 30-minute podcast or video in only 2 minutes.</p><!----></article><!--]--></div></div><div class="grid-4 item" data-v-b2dd8c3f><div class="VPLink no-icon VPFeature" data-v-b2dd8c3f data-v-0f8d4bce><!--[--><article class="box" data-v-0f8d4bce><div class="icon" data-v-0f8d4bce>💻</div><h2 class="title" data-v-0f8d4bce>Apple Silicon GPU Acceleration</h2><p class="details" data-v-0f8d4bce>An M1 Max can process a 30-minute podcast or video in only 2 minutes.</p><!----></article><!--]--></div></div><div class="grid-4 item" data-v-b2dd8c3f><div class="VPLink no-icon VPFeature" data-v-b2dd8c3f data-v-0f8d4bce><!--[--><article class="box" data-v-0f8d4bce><div class="icon" data-v-0f8d4bce>📝</div><h2 class="title" data-v-0f8d4bce>Floating Notes</h2><p class="details" data-v-0f8d4bce>Display key points as floating pop-up notes while audio plays.</p><!----></article><!--]--></div></div><div class="grid-4 item" data-v-b2dd8c3f><div class="VPLink no-icon VPFeature" data-v-b2dd8c3f data-v-0f8d4bce><!--[--><article class="box" data-v-0f8d4bce><div class="icon" data-v-0f8d4bce>💬</div><h2 class="title" data-v-0f8d4bce>Live Subtitles</h2><p class="details" data-v-0f8d4bce>Display real-time subtitles as audio plays back.</p><!----></article><!--]--></div></div><div class="grid-4 item" data-v-b2dd8c3f><div class="VPLink no-icon VPFeature" data-v-b2dd8c3f data-v-0f8d4bce><!--[--><article class="box" data-v-0f8d4bce><div class="icon" data-v-0f8d4bce>🎞️</div><h2 class="title" data-v-0f8d4bce>Local Media Support</h2><p class="details" data-v-0f8d4bce>Supports local media files like MP4, MP3, AAC, M4A and more.</p><!----></article><!--]--></div></div><div class="grid-4 item" data-v-b2dd8c3f><div class="VPLink no-icon VPFeature" data-v-b2dd8c3f data-v-0f8d4bce><!--[--><article class="box" data-v-0f8d4bce><div class="icon" data-v-0f8d4bce>✂️</div><h2 class="title" data-v-0f8d4bce>Clip Segmentation</h2><p class="details" data-v-0f8d4bce>Isolate and clip audio segments for transcription.</p><!----></article><!--]--></div></div><div class="grid-4 item" data-v-b2dd8c3f><div class="VPLink no-icon VPFeature" data-v-b2dd8c3f data-v-0f8d4bce><!--[--><article class="box" data-v-0f8d4bce><div class="icon" data-v-0f8d4bce>⚙️</div><h2 class="title" data-v-0f8d4bce>Customize AI Prompts</h2><p class="details" data-v-0f8d4bce>Customize the AI assistant prompts for personalized responses.</p><!----></article><!--]--></div></div><div class="grid-4 item" data-v-b2dd8c3f><div class="VPLink no-icon VPFeature" data-v-b2dd8c3f data-v-0f8d4bce><!--[--><article class="box" data-v-0f8d4bce><div class="icon" data-v-0f8d4bce>🤖</div><h2 class="title" data-v-0f8d4bce>AI Summarization</h2><p class="details" data-v-0f8d4bce>Generate smart summaries of transcripts using AI (bring your own key).</p><!----></article><!--]--></div></div><div class="grid-4 item" data-v-b2dd8c3f><div class="VPLink no-icon VPFeature" data-v-b2dd8c3f data-v-0f8d4bce><!--[--><article class="box" data-v-0f8d4bce><div class="icon" data-v-0f8d4bce>📄</div><h2 class="title" data-v-0f8d4bce>Export Options</h2><p class="details" data-v-0f8d4bce>Export subtitles, Markdown and Notion. More integrations coming soon!</p><!----></article><!--]--></div></div><div class="grid-4 item" data-v-b2dd8c3f><div class="VPLink no-icon VPFeature" data-v-b2dd8c3f data-v-0f8d4bce><!--[--><article class="box" data-v-0f8d4bce><div class="icon" data-v-0f8d4bce>🖥️</div><h2 class="title" data-v-0f8d4bce>Cross-platform</h2><p class="details" data-v-0f8d4bce>Works on Windows, macOS.</p><!----></article><!--]--></div></div><div class="grid-4 item" data-v-b2dd8c3f><div class="