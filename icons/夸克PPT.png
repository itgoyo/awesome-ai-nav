            function getLastestAsyncSSRCache() {
                let result = null;
                const initVersion = "0.1.138";
                const version = initVersion.split('-')[0];
                const keyBiz = 'compassAsyncSSR_AIPPT';
                const keyPrefix = keyBiz + '_' + version;
                for (let i = 0; i < localStorage.length; i++) {
                  const localKey = localStorage.key(i);
                  if (localKey.indexOf(keyBiz) === 0) {
                    if (localKey.indexOf(keyPrefix) === 0) {
                      const cache = localStorage.getItem(localKey);
                      try {
                        const cacheObj = JSON.parse(cache);
                        result = cacheObj;
                      } catch {
                        localStorage.removeItem(localKey);
                      }
                    } else {
                      localStorage.removeItem(localKey);
                    }
                  }
                }
                if (result) {
                  return result.html;
                }
                return null;
              }

              const mHeader = document.getElementById('mhome-header');
              if(location.href.indexOf('/m-home') > -1 && !mHeader) {
                let needRefresh = 0;

                const hasKp = localStorage.getItem('hasKp');

                if (hasKp === null) {
                  needRefresh = 1;
                  localStorage.setItem('hasKp', 'false');
                } else {
                  const currentHasKp = 'false';
                  if (hasKp !== currentHasKp) {
                    needRefresh = 1;
                    localStorage.setItem('hasKp', 'false');
                  }
                }

                window.__NeedRefresh = needRefresh;

                const rootContainer = document.getElementById('root');
                const starTime = Date.now();
                const cachedHtml = getLastestAsyncSSRCache();

                if (cachedHtml && rootContainer && needRefresh === 0) {
                  console.log('使用并行SSR缓存');
                  rootContainer.innerHTML = cachedHtml;
                  window.__HasInJectHTML = true;
                  console.log('并行SSR缓存上屏执行耗时', Date.now() - starTime);
                }
              }
            </script><script>window.__itrace_conf={bid:"ai-tpl-734",rel:"0.1.138",plugins:["jserror","interface","resource","blank",{id:"perf",enableLCP:!0}]};</script><script>window.__VERSION='0.1.138';window.ENV_TYPE = "prod"; window.__INITIAL_PROPS__ = {"version":"1.0.0","routeConfig":{},"isOfflinePackage":"","renderType":"CSR"}</script><script src="https://g.alicdn.com/woodpeckerx/itrace-next/??itrace-jserror.iife.js,itrace-interface.iife.js,itrace-perf.iife.js,itrace-resource.iife.js,itrace-blank.iife.js,itrace.iife.js"></script><script src="https://cdn.sm.cn/static/23/04/25/3cde607913ae667784e86b8506c262e8.js"></script><script src="https://cdn.sm.cn/static/23/04/25/e77c34b82e56c058c308b9f602b8b926.js"></script><script src="https://blm.sm.cn/prod/bloom/qk-ai-ppt/client/static/js/home.7b2e60fefeb007df4442.js"></script><script>if (window?.QK_THEME_TYPE === 'night') {
